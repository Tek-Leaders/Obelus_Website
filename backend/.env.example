# Copy to .env and fill in. .env is gitignored - never commit real values.

# --- core ---------------------------------------------------------------
# python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
TIME_ZONE=Asia/Kolkata

# --- database -----------------------------------------------------------
# Leave DB_ENGINE unset to use SQLite while developing.
DB_ENGINE=mysql
DB_NAME=obelus
DB_USER=obelus
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# --- email --------------------------------------------------------------
# The console backend prints mail instead of sending it. Switch to the SMTP
# backend below and fill in a provider to deliver for real, then check with:
#   python manage.py test_email --to you@example.com
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
#EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

# Gmail / Google Workspace. EMAIL_HOST_PASSWORD must be a 16-character app
# password (myaccount.google.com/apppasswords, needs 2-Step Verification on),
# never the account password. Gmail will not let you send as another domain,
# so DEFAULT_FROM_EMAIL has to be this same address.
#EMAIL_HOST=smtp.gmail.com
#EMAIL_HOST_USER=you@gmail.com
#EMAIL_HOST_PASSWORD=abcdefghijklmnop
#DEFAULT_FROM_EMAIL=OBELUS Website <you@gmail.com>

# Zoho (likely, if info@obelus.in is hosted there). Use .com not .in if the
# account was created outside India.
#EMAIL_HOST=smtp.zoho.in
#EMAIL_HOST_USER=noreply@obelus.in
#EMAIL_HOST_PASSWORD=
#DEFAULT_FROM_EMAIL=OBELUS Website <noreply@obelus.in>

EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=OBELUS Website <noreply@obelus.in>

# Where form notifications are sent. Comma-separate for several recipients.
LEADS_NOTIFY_TO=info@obelus.in
# Also send the visitor a confirmation.
LEADS_SEND_ACKNOWLEDGEMENT=True

# --- API ----------------------------------------------------------------
SUBMISSION_RATE=10/hour
# Only if the API is on a different origin than the site.
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=
